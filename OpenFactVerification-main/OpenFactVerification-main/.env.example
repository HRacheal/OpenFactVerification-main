# Kweli Lens AI configuration.
# 1. Copy this file to ".env" in the same folder:   Copy-Item .env.example .env
# 2. Fill in the keys for the services you use.  NEVER commit .env or share keys in chat/screenshots.
# Real environment variables override values in this file.

# --- Required: evidence search (https://serper.dev) ---
SERPER_API_KEY=

# --- Required: ONE AI provider ---
# OpenAI (default provider)
OPENAI_API_KEY=
# Anthropic Claude (optional alternative provider)
ANTHROPIC_API_KEY=
# Google Gemini (optional alternative provider, free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Provider / model selection (optional) ---
# openai | claude | gemini | local   (if empty: the first of OpenAI, Claude, Gemini whose key is set)
TRUTHLENS_PROVIDER=
# Model ID available to your account. Defaults: gpt-4.1-mini (OpenAI), claude-opus-5-5 (Claude), gemini-3.8-flash (Gemini).
# Cheaper Claude options: claude-sonnet-5-5, claude-haiku-5-5
TRUTHLENS_MODEL=
# Gemini only: attempts per request (incl. the first) on 429/5xx such as 503 "high demand"; backoff 2s..30s
TRUTHLENS_GEMINI_RETRIES=5
# --- Speech-to-text: local faster-whisper (free, open source, no API key) ---
# on | off | auto. auto = on, except on Render (free instances are too small) where it stays off unless set to on.
TRUTHLENS_TRANSCRIPTION=auto
# tiny (fastest, least accurate) | base | small | medium (slow on CPU). base is a good CPU default.
TRUTHLENS_WHISPER_MODEL=base
# cpu | cuda.  int8 suits CPUs; use float16 on an NVIDIA GPU.
TRUTHLENS_WHISPER_DEVICE=cpu
TRUTHLENS_WHISPER_COMPUTE_TYPE=int8
# Beam size: 5 = default accuracy, 1 = faster
TRUTHLENS_WHISPER_BEAM_SIZE=5
# Folder for the downloaded model (default: the Hugging Face cache in your user folder)
TRUTHLENS_WHISPER_CACHE_DIR=
# 1 = never download, only use a model already downloaded (python -m factcheck.utils.transcription --download)
TRUTHLENS_WHISPER_LOCAL_ONLY=0
# Only the first N seconds of a recording are transcribed
TRUTHLENS_MAX_AUDIO_SECONDS=600
# Claude only: low | medium | high | xhigh | max (invalid values fall back to medium)
# and server-side refusal fallback for Opus/Sonnet 5.x (1 = on, 0 = off; Haiku has no fallback)
CLAUDE_EFFORT=medium
CLAUDE_REFUSAL_FALLBACK=1

# --- Local OpenAI-compatible server (optional, e.g. FastChat/vLLM) ---
LOCAL_API_KEY=
LOCAL_API_URL=

# --- Web app (optional) ---
# Random secret for signing session cookies; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
TRUTHLENS_HOST=127.0.0.1
TRUTHLENS_PORT=2024
# Seconds a finished report stays available in memory (default 3600)
TRUTHLENS_RESULT_TTL=3600
# Video limits
TRUTHLENS_MAX_VIDEO_SECONDS=600
TRUTHLENS_VIDEO_FRAMES=8
# Full path to ffmpeg.exe if it is not on PATH (needed to extract the audio track from videos)
FFMPEG_PATH=
